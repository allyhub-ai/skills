// The gallery on Cloudflare: the built site (dist/) as the Worker's static
// assets, on the two allyhub.com paths it owns. Everything else on
// allyhub.com does not reach this Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allyhub-skills",
  // AllyHub's Cloudflare account, which holds the allyhub.com zone.
  "account_id": "d701f93241afc0f4438eb00243f048f8",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs only for the pages (/skills/ and /skills/<name>/), to
    // answer an agent that asks for Markdown. Everything else is a static
    // asset, which Cloudflare serves free and unmetered, never counted
    // against the Workers request quota.
    "run_worker_first": ["/skills/", "/skills/*/"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "allyhub.com/skills", "zone_name": "allyhub.com" },
    { "pattern": "allyhub.com/skills/*", "zone_name": "allyhub.com" },
    { "pattern": "allyhub.com/.well-known/agent-skills/*", "zone_name": "allyhub.com" }
  ],
  "observability": { "enabled": true }
}
